# Copy to .env and adjust. .env is gitignored.

# Which config class to load: development | testing | production
APP_CONFIG=development

# Lets `flask` find the app factory without --app on every command.
FLASK_APP=blog

# Required when APP_CONFIG=production; ignored in development.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# Optional. Defaults to SQLite at instance/blog.db.
# DATABASE_URL=postgresql+psycopg://blog:blog@localhost:5432/blog
